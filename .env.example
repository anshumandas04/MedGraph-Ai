# MedGraph Environment Configuration

# Application
APP_NAME=MedGraph
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://medgraph:medgraph@db:5432/medgraph
DATABASE_URL_SYNC=postgresql://medgraph:medgraph@db:5432/medgraph
POSTGRES_USER=medgraph
POSTGRES_PASSWORD=medgraph
POSTGRES_DB=medgraph

# Authentication
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./data/uploads

# AI Provider (mock or openai)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# OCR Provider (mock or tesseract)
OCR_PROVIDER=mock

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]

# Demo Mode
DEMO_MODE=true
