# MedGraph Environment Configuration

# Application
APP_NAME=MedGraph
APP_VERSION=0.1.0
DEBUG=false
SQL_ECHO=false
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://medgraph:change-me-for-local-development@db:5432/medgraph
DATABASE_URL_SYNC=postgresql://medgraph:change-me-for-local-development@db:5432/medgraph
POSTGRES_USER=medgraph
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=medgraph

# Authentication
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./data/uploads

# Local rules are the default and do not transmit document text. Set openai explicitly to enable external processing.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# OCR Provider (auto extracts PDF text then uses local Tesseract as needed)
OCR_PROVIDER=auto
TESSERACT_CMD=
OCR_LANGUAGE=eng
OCR_MIN_TEXT_CHARS=24
OCR_MAX_PAGES=100
OCR_RENDER_DPI=220

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]

# Demo Mode
DEMO_MODE=false
